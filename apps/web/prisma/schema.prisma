// StudyFlow AI - Prisma Schema
// Phase 2: pgvector embeddings, full StudyMaterial, Chat, Summary models

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────────────────────
// Auth models (NextAuth / Auth.js)
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  courses         Course[]
  studyMaterials  StudyMaterial[]
  summaries       Summary[]
  quizAttempts    QuizAttempt[]
  weakTopics      WeakTopic[]
  annotations     Annotation[]
  chatSessions    ChatSession[]
  studyActivities StudyActivity[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// Course & Exam
// ─────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam            Exam?
  studyMaterials  StudyMaterial[]
  documentChunks  DocumentChunk[]
  summaries       Summary[]
  quizzes         Quiz[]
  weakTopics      WeakTopic[]
  annotations     Annotation[]
  chatSessions    ChatSession[]
  studyActivities StudyActivity[]

  @@index([userId])
}

model Exam {
  id        String   @id @default(cuid())
  courseId  String   @unique
  examDate  DateTime
  title     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Study Materials & Document Chunks
// ─────────────────────────────────────────────────────────────

model StudyMaterial {
  id               String    @id @default(cuid())
  userId           String
  courseId         String
  originalFilename String
  storedFilename   String
  fileUrl          String?
  mimeType         String
  fileSize         Int
  // PENDING → PROCESSING → READY | FAILED
  status           String    @default("PENDING")
  processingError  String?   @db.Text
  pageCount        Int?
  chunkCount       Int?
  processedAt      DateTime? // set when status becomes READY or FAILED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  documentChunks DocumentChunk[]
  annotations    Annotation[]

  @@index([userId])
  @@index([courseId])
}

// Stores text chunks extracted from StudyMaterial documents.
// embedding column stores pgvector 1536-dim vectors.
model DocumentChunk {
  id              String   @id @default(cuid())
  courseId        String
  studyMaterialId String
  content         String   @db.Text
  chunkIndex      Int
  pageNumber      Int?
  metadata        Json?
  // pgvector column — queried via raw SQL in the AI service
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime @default(now())

  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studyMaterial StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([studyMaterialId])
}

// ─────────────────────────────────────────────────────────────
// Summaries
// ─────────────────────────────────────────────────────────────

model Summary {
  id          String   @id @default(cuid())
  courseId    String
  userId      String
  title       String
  content     String   @db.Text
  // "SHORT" | "DETAILED" | "BULLET" | "EXAM_FOCUSED"
  summaryType String   @default("SHORT")
  // "NOTES_ONLY" | "HYBRID"
  mode        String   @default("HYBRID")
  sources     Json?    // SourceReference[]
  materialIds Json?    // String[] — which materials were summarised
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Quizzes
// ─────────────────────────────────────────────────────────────

model Quiz {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  question      String   @db.Text
  options       Json
  correctAnswer String
  explanation   String?  @db.Text
  orderIndex    Int
  createdAt     DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  score       Float
  totalQ      Int
  answers     Json
  completedAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Weak Topics
// ─────────────────────────────────────────────────────────────

model WeakTopic {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  topic      String
  confidence Float     @default(0.0)
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, topic])
  @@index([userId, courseId])
}

// ─────────────────────────────────────────────────────────────
// Annotations
// ─────────────────────────────────────────────────────────────

model Annotation {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  studyMaterialId String
  content         String   @db.Text
  pageNumber      Int?
  highlightedText String?  @db.Text
  color           String   @default("yellow")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studyMaterial StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
  @@index([studyMaterialId])
}

// ─────────────────────────────────────────────────────────────
// Chat
// ─────────────────────────────────────────────────────────────

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  title     String?
  mode      String   @default("HYBRID") // "NOTES_ONLY" | "HYBRID"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, courseId])
}

model ChatMessage {
  id            String   @id @default(cuid())
  chatSessionId String
  role          String   // "USER" | "ASSISTANT"
  content       String   @db.Text
  // "NOTES_ONLY" | "HYBRID" — the mode active when this message was generated
  mode          String?
  sources       Json?    // SourceReference[]
  tokenUsage    Json?    // { promptTokens, completionTokens, totalTokens }
  promptVersion String?  // semver string from prompts.PROMPT_VERSION
  createdAt     DateTime @default(now())

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
}

// ─────────────────────────────────────────────────────────────
// Study Activity
// ─────────────────────────────────────────────────────────────

model StudyActivity {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  activityType String   // "CHAT" | "QUIZ" | "SUMMARY" | "NOTES" | "VOICE"
  durationMin  Int?
  createdAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
  @@index([userId, createdAt])
}
