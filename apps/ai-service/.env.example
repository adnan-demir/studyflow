# AI Service Environment Variables

# Same PostgreSQL instance as the web app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# CORS - comma-separated allowed origins
ALLOWED_ORIGINS="http://localhost:3000"

# OpenAI (or compatible provider)
OPENAI_API_KEY=""
# Optional: override the base URL for OpenAI-compatible providers
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Models
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
LLM_MODEL="gpt-4o"

# Chunking config
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval config
RETRIEVAL_TOP_K=6
# Max chunks fetched from DB before budget trimming (must be >= RETRIEVAL_TOP_K)
MAX_RETRIEVAL_CHUNKS=10
# Token budget for context window (system prompt + history + chunks must stay under this)
MAX_CONTEXT_TOKENS=6000
# Minimum cosine similarity (0–1) to admit a retrieved chunk into context
SIMILARITY_THRESHOLD=0.30
# Max characters allowed in a single chat message
MAX_CHAT_MESSAGE_LENGTH=4000
